   "params": {
    "type": "object",
    "properties": {
     "at": {
      "description": "A bar number (1-based), a marker name, or \"playhead\"",
      "anyOf": [
       {
        "type": "integer",
        "minimum": 1
       },
       {
        "type": "string"
       }
      ]
     },
     "where": {
      "type": "string",
      "enum": [
       "cues",
       "everywhere"
      ]
     }
    },
    "required": [
     "at",
     "where"
    ],
    "additionalProperties": false
   }
  },
