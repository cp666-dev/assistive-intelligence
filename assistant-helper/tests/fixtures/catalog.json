{
 "actions": [
  {
   "name": "createTracks",
   "description": "Create audio or instrument tracks, optionally on hardware inputs (\"1\", \"5-6\" for a stereo pair, or an input name). Tracks are created in the order given.",
   "params": {
    "type": "object",
    "properties": {
     "tracks": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "name": {
         "type": "string"
        },
        "kind": {
         "type": "string",
         "enum": [
          "audio",
          "instrument"
         ]
        },
        "format": {
         "type": "string",
         "enum": [
          "mono",
          "stereo"
         ]
        },
        "input": {
         "type": "string"
        },
        "color": {
         "type": "string"
        }
       },
       "required": [
        "name"
       ],
       "additionalProperties": false
      }
     },
     "recordArm": {
      "type": "boolean"
     }
    },
    "required": [
     "tracks"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "createBus",
   "description": "Create an aux bus.",
   "params": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "format": {
      "type": "string",
      "enum": [
       "mono",
       "stereo"
      ]
     }
    },
    "required": [
     "name"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "setOutput",
   "description": "Route the main output of tracks/buses to a bus (created if missing) or \"main\" (the main output).",
   "params": {
    "type": "object",
    "properties": {
     "channels": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "Track or bus names as the user says them"
     },
     "to": {
      "type": "string"
     }
    },
    "required": [
     "channels",
     "to"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "createGroup",
   "description": "Create a group linking tracks/buses so one fader/edit controls all of them.",
   "params": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "members": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "Track or bus names as the user says them"
     },
     "links": {
      "type": "array",
      "items": {
       "type": "string",
       "enum": [
        "mix",
        "edit",
        "plugin"
       ]
      }
     }
    },
    "required": [
     "name",
     "members"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "addSend",
   "description": "Add a send from tracks to a bus (created stereo if missing).",
   "params": {
    "type": "object",
    "properties": {
     "from": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "Track or bus names as the user says them"
     },
     "to": {
      "type": "string"
     },
     "levelDb": {
      "type": "number"
     },
     "preFader": {
      "type": "boolean"
     }
    },
    "required": [
     "from",
     "to"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "insertPlugin",
   "description": "Load a plugin (search text such as \"dbx 160\", \"1176\", \"LA-2A\") on a track or bus.",
   "params": {
    "type": "object",
    "properties": {
     "on": {
      "type": "string"
     },
     "plugin": {
      "type": "string"
     }
    },
    "required": [
     "on",
     "plugin"
    ],
    "additionalProperties": false
   }
  },
