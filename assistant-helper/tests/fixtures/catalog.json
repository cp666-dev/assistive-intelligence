      "description": "A bar number (1-based), a marker name, or \"playhead\"",
      "anyOf": [
       {
        "type": "integer",
        "minimum": 1
       },
       {
        "type": "string"
       }
      ]
     }
    },
    "required": [
     "name",
     "at"
    ],
    "additionalProperties": false
   }
  },
