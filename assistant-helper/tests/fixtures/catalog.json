    ],
    "additionalProperties": false
   }
  },
  {
   "name": "setStartEarlier",
   "description": "Move the play/record start N bars earlier, giving more intro before the performers come in.",
   "params": {
    "type": "object",
    "properties": {
     "bars": {
      "type": "integer",
      "minimum": 1
     }
    },
    "required": [
